# 复制为 deploy/.env 后填写；compose 会自动读取同目录的 .env
#   cp .env.sfu.example .env

# 对外域名（必须有 A 记录指向本机，移动端观看必须 HTTPS）
DOMAIN=ts.example.com

# 网关访问口令，决定谁能用这个网关
# 生成：openssl rand -base64 24 | tr -d '/+=' | head -c 32
ACCESS_TOKEN=换成你的口令

# LiveKit API 密钥对：网关用它签 JWT，LiveKit 用它校验
# 生成：openssl rand -hex 16   （key）；openssl rand -hex 32 （secret）
LIVEKIT_API_KEY=换成32位十六进制
LIVEKIT_API_SECRET=换成64位十六进制
